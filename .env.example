# .env — LOCAL development only. Do NOT commit to git.
# Copy this file and fill in your values.

# Flask secret key (any random string)
SECRET_KEY=change-me-to-something-random-123

# Leave blank to use SQLite locally. For Supabase/Render, paste your PostgreSQL URL here:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Room name shown in the app
ROOM_NAME=Room 33

# Admin password hash — generate with:
# python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:...
